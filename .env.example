# Required in production: password for admin mode (share only with people who manage maintenance)
ADMIN_PASSWORD=change-me

# Recommended: long random text used to sign admin logins
AUTH_SECRET=

# Your apartment's name (page title, installed app name). Can also be changed in Admin → Settings.
NEXT_PUBLIC_APARTMENT_NAME=
# Optional shorter name shown under the home-screen icon
NEXT_PUBLIC_APARTMENT_SHORT_NAME=

# Storage (production). Added automatically when you connect "Upstash for Redis" in Vercel.
# Without these, data is stored in ./data/db.json (local development only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
